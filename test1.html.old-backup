<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Fixed Table Processor</title>
    <style>
        .control-panel {
            margin-bottom: 15px;
            font-family: sans-serif;
        }
        #paste-zone {
            width: 100%;
            height: 120px;
            border: 2px dashed #3498db;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            color: #333;
            background-color: #f9f9f9;
        }
        table {
            border-collapse: collapse;
            width: 100%;
            margin-top: 20px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
        }
        th { background-color: #f4f4f4; font-weight: bold; }
    </style>
</head>
<body>

<!-- User Interface Settings Panel -->
<div class="control-panel">
    <label for="column-count"><strong>How many columns should this table have? </strong></label>
    <input type="number" id="column-count" value="4" min="1" style="width: 60px; padding: 4px;">
</div>

<!-- Target Container for Pasting -->
<div id="paste-zone" contenteditable="true">
    Click here and press Ctrl+V (or Cmd+V) to paste table data
</div>

<!-- Destination Container for Clean Table Output -->
<div id="table-container"></div>

<script>
    const pasteZone = document.getElementById('paste-zone');
    const tableContainer = document.getElementById('table-container');
    const colInput = document.getElementById('column-count');

    pasteZone.addEventListener('paste', handlePaste);

    function handlePaste(event) {
        event.preventDefault();
        tableContainer.innerHTML = '';

        const clipboardData = event.clipboardData || window.clipboardData;
        const htmlData = clipboardData.getData('text/html');
        const plainTextData = clipboardData.getData('text/plain');

        // Get the user's forced column width
        const userColumnsCount = parseInt(colInput.value, 10) || 1;

        // Priority 1: Use raw structured HTML table formatting if available
        if (htmlData && htmlData.includes('<table')) {
            parseHtmlToTable(htmlData);
        }
        // Priority 2: Re-chunk flat plain text into the user's specific width
        else if (plainTextData) {
            parseTextToTableCustom(plainTextData, userColumnsCount);
        }
    }

    function parseTextToTableCustom(textString, targetColumns) {
        // 1. Extract values by splitting ONLY on line breaks and tabs.
        // This treats commas as text inside the cell rather than breaking them apart.
        const rawItems = textString.split(/[\r\n\t]+/);

        // Clean white space and filter out absolute trailing empty slots
        const cleanCells = rawItems.map(item => item.trim()).filter(item => item.length > 0);
        if (cleanCells.length === 0) return;

        const table = document.createElement('table');
        let currentTr = document.createElement('tr');

        cleanCells.forEach((cellText, index) => {
            // Drop to a new row whenever the row index hits the user's column width configuration
            if (index > 0 && index % targetColumns === 0) {
                table.appendChild(currentTr);
                currentTr = document.createElement('tr');
            }

            // First row acts as headers, remaining rows act as standard body items
            const cellTag = (index < targetColumns) ? 'th' : 'td';
            const cell = document.createElement(cellTag);
            cell.textContent = cellText;
            currentTr.appendChild(cell);
        });

        // Clean up and append any remaining cells left in the pipeline array
        if (currentTr.children.length > 0) {
            table.appendChild(currentTr);
        }

        tableContainer.appendChild(table);
    }

    function parseHtmlToTable(htmlString) {
        const parser = new DOMParser();
        const doc = parser.parseFromString(htmlString, 'text/html');
        const sourceTable = doc.querySelector('table');

        if (sourceTable) {
            const cleanTable = document.createElement('table');
            const rows = sourceTable.querySelectorAll('tr');

            rows.forEach(sourceRow => {
                const tr = document.createElement('tr');
                const cells = sourceRow.querySelectorAll('th, td');

                cells.forEach(sourceCell => {
                    const cell = document.createElement(sourceCell.tagName.toLowerCase());
                    cell.textContent = sourceCell.textContent.trim();
                    tr.appendChild(cell);
                });

                if (tr.children.length > 0) {
                    cleanTable.appendChild(tr);
                }
            });

            tableContainer.appendChild(cleanTable);
        }
    }
</script>
</body>
</html>
